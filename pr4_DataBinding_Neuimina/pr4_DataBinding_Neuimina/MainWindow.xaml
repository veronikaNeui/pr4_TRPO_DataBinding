<Window x:Class="pr4_DataBinding_Neuimina.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr4_DataBinding_Neuimina"
        mc:Ignorable="d"
        Title="Смартфон" Height="450" Width="800">
    <DockPanel>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="450" />
                <ColumnDefinition Width="*" />

            </Grid.ColumnDefinitions>

            <StackPanel>
                <Label Content="ID смартфона: " />
                <Label Content="Модель: "  />
                <Label Content="Производитель: " />
                <Label Content="Цена: " />
                <Label Content="Скидка (%): "/>
            </StackPanel>

            

            <StackPanel Grid.Column="1">
                <TextBox Text="{Binding Id}" Grid.Column="1" HorizontalAlignment="Left" Width="30" Margin="0,5,0,0" />
                <TextBox Text="{Binding Model}" Grid.Column="1" Margin="0,5,5,0" />
                <TextBox Text="{Binding Manufacturer}" Grid.Column="1" Margin="0,5,5,0" />
                <TextBox Text="{Binding Price}" Grid.Column="1" Margin="0,5,5,0" />
                <TextBox Text="{Binding Discount}" Grid.Column="1" Margin="0,5,5,0" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Идентификатор: " />
                <TextBlock Text="{Binding Id}" />
                <TextBlock Text="Модель: " />
                <TextBlock Text="{Binding Model}" />
                <TextBlock Text="Производитель: " />
                <TextBlock Text="{Binding Manufacturer}" />
                <TextBlock Text="Цена: " />
                <TextBlock Text="{Binding Price}" />
                <TextBlock Text="Скидка: " />
                <TextBlock Text="{Binding Discount}" />



            </StackPanel>
            

            <Label Content="Цена со скидкой: " Grid.Row="2" Grid.Column="0" />
            <Label Content="{Binding DiscountedPrice}" Grid.Row="2" Grid.Column="1" />

            <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center"  Margin="0,0,10,10">
                <Button Content="Сохранить" Margin="0,0,10,0" Width="80" Height="30" Click="Button_Click"/>
                <Button Content="Новая запись" Margin="0,0,10,0" Width="90" Click="Button_Click_1" />
                
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center" Margin="15" >
                <Label Content="Поиск по ID: " Margin="0,0,10,0" FontSize="14" VerticalAlignment="Center"/>
                <TextBox x:Name="Poisk" Margin="2" Width="40" Padding="3"/>
                <Button Content="Найти" Margin="5" Width="70" Height="30" Click="Button_Click_2" />


            </StackPanel>


        </Grid>
        

    </DockPanel>
</Window>
